@model CVApplication.Models.OffreEmploi

@{
    ViewData["Title"] = "Supprimer l'offre";
}

<h2 class="text-danger">Supprimer l'offre</h2>

<div class="alert alert-warning">
    Êtes-vous sûr de vouloir supprimer cette offre ?
</div>

<div class="card p-3 mb-3">

    <p><strong>Titre :</strong> @Model.Titre</p>
    <p><strong>Description :</strong> @Model.Description</p>
    <p><strong>Compétences :</strong> @Model.CompetencesAttendues</p>

</div>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Oui, supprimer
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Annuler
    </a>

</form>
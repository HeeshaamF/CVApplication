@model CVApplication.Models.OffreEmploi

@{
    ViewData["Title"] = "Nouvelle offre";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h2><i class="bi bi-briefcase"></i> Nouvelle offre d'emploi</h2>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">

            <div class="mb-3">
                <label asp-for="Titre" class="form-label">
                    <i class="bi bi-card-text"></i> Titre
                </label>
                <input asp-for="Titre" class="form-control" placeholder="Ex: Développeur Logiciel"/>
                <span asp-validation-for="Titre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    <i class="bi bi-info-circle"></i> Description
                </label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Décrivez l'offre..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CompetencesAttendues" class="form-label">
                    <i class="bi bi-tools"></i> Compétences attendues
                </label>
                <textarea asp-for="CompetencesAttendues" class="form-control" rows="2" placeholder="Ex: C#, ASP.NET Core, SQL Server"></textarea>
                <span asp-validation-for="CompetencesAttendues" class="text-danger"></span>
                
            </div>

            <button class="btn btn-success">
                <i class="bi bi-check-circle"></i> Enregistrer
            </button>
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial"/>
}

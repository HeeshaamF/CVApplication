@model CVApplication.Models.OffreEmploi

@{
    ViewData["Title"] = "Modifier l'offre";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-warning text-dark">
        <h2><i class="bi bi-pencil-square"></i> Modifier l'offre</h2>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Titre" class="form-label">
                    <i class="bi bi-card-text"></i> Titre
                </label>
                <input asp-for="Titre" class="form-control" placeholder="Ex: Développeur Logiciel"/>
                <span asp-validation-for="Titre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    <i class="bi bi-info-circle"></i> Description
                </label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Décrivez l'offre..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CompetencesAttendues" class="form-label">
                    <i class="bi bi-tools"></i> Compétences attendues
                </label>
                <textarea asp-for="CompetencesAttendues" class="form-control" rows="3" placeholder="Ex: C#, ASP.NET Core, SQL Server"></textarea>
                <span asp-validation-for="CompetencesAttendues" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary me-2">
                <i class="bi bi-check-circle"></i> Enregistrer
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Annuler
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

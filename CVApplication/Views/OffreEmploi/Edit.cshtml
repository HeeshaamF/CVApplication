@model CVApplication.Models.OffreEmploi

@{
    ViewData["Title"] = "Modifier l'offre";
}

<h2>Modifier l'offre</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Titre" class="form-label"></label>
        <input asp-for="Titre" class="form-control" />
        <span asp-validation-for="Titre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CompetencesAttendues" class="form-label"></label>
        <textarea asp-for="CompetencesAttendues" class="form-control" rows="3"></textarea>
        <span asp-validation-for="CompetencesAttendues" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Enregistrer
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Annuler
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
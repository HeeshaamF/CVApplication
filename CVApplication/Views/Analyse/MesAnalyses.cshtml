@model IEnumerable<CVApplication.Models.AnalyseCV>

<h2>Historique des analyses</h2>

<table class="table table-striped">

    <thead>
    <tr>
        <th>Upload CV</th>
        <th>CV</th>
        <th>Structure</th>
        <th>Compétences</th>
        <th>Lisibilité</th>
    </tr>
    </thead>

    <tbody>

    @foreach (var analyse in Model)
    {
        <tr>
            
            <td>@analyse.CV.DateUpload</td>
            
            <td>@analyse.CV.Nom</td>

            <td>@analyse.ScoreStructure %</td>

            <td>@analyse.ScoreCompetences %</td>

            <td>@analyse.ScoreLisibilite %</td>

        </tr>
    }

    </tbody>

</table>
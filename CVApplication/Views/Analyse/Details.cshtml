@model CVApplication.ViewModels.AnalyseCVViewModel

<h2>Analyse du CV : @Model.CV.Nom</h2>

<table class="table table-bordered mt-3">
    <thead>
    <tr>
        <th>Date CV</th>
        <th>Structure</th>
        <th>Compétences</th>
        <th>Lisibilité</th>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td>@Model.CV.DateUpload.ToString("dd/MM/yyyy")</td>
        <td>@Model.Analyses.First().ScoreStructure %</td>
        <td>@Model.Analyses.First().ScoreCompetences %</td>
        <td>@Model.Analyses.First().ScoreLisibilite %</td>
    </tr>
    </tbody>
</table>

<h3>Rapport</h3>

<div class="mt-4">
    <a asp-controller="Rapport"
       asp-action="Telecharger"
       asp-route-analyseId="@Model.Analyses.First().Id"
       class="btn btn-info text-white">
        Télécharger le rapport PDF
    </a>
</div>
@model CVApplication.ViewModels.AnalyseCVViewModel

<h2>Analyses du CV : @Model.CV.Nom</h2>

<table class="table table-bordered mt-3">
    <thead>
    <tr>
        <th>Date CV</th>
        <th>Structure</th>
        <th>Compétences</th>
        <th>Lisibilité</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var a in Model.Analyses)
    {
        <tr>
            <td>@Model.CV.DateUpload.ToString("dd/MM/yyyy")</td>
            <td>@a.ScoreStructure %</td>
            <td>@a.ScoreCompetences %</td>
            <td>@a.ScoreLisibilite %</td>
        </tr>
    }
    </tbody>
</table>

<h3>Recommandations</h3>
@foreach (var a in Model.Analyses)
{
    <ul>
        @foreach (var r in a.Recommandations)
        {
            <li>@r.Message</li>
        }
    </ul>
}

<div class="mt-4">
    <a asp-controller="Rapport" asp-action="Telecharger" asp-route-analyseId="@Model.Analyses.FirstOrDefault()?.Id" class="btn btn-info">
        Télécharger le rapport PDF
    </a>
</div>
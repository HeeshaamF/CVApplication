@model CVApplication.ViewModels.ComparaisonCVViewModel

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h2><i class="bi bi-diagram-2"></i> Comparer mon CV à une offre</h2>
    </div>
    <div class="card-body">

        <form asp-action="ComparerResult"
              asp-controller="Analyse"
              method="get">

            <input type="hidden" asp-for="CVId" />

            <div class="mb-3">
                <label class="form-label fw-bold">
                    <i class="bi bi-briefcase"></i> Offre d'emploi
                </label>

                <select asp-for="OffreId" class="form-select">
                    <option value="">-- Choisir une offre --</option>
                    @foreach (var offre in Model.Offres)
                    {
                        <option value="@offre.Id">@offre.Titre</option>
                    }
                </select>
                <div class="form-text">
                    Sélectionnez une offre pour comparer vos compétences.
                </div>
            </div>

            <button class="btn btn-success w-100">
                <i class="bi bi-arrow-left-right"></i> Comparer
            </button>
        </form>
    </div>
</div>
@model CVApplication.ViewModels.ResultatMatchingViewModel

<h2>Résultat du matching</h2>

<table class="table table-bordered">

    <tr>
        <th>CV</th>
        <td>@Model.CV.Nom</td>
    </tr>

    <tr>
        <th>Offre</th>
        <td>@Model.Offre.Titre</td>
    </tr>

    <tr>
        <th>Score de matching</th>
        <td>
            @if (@Model.ScoreMatching >= 80)
            {
                <span class="badge bg-success">@($"{@Model.ScoreMatching} %")</span>
            }
            else if (@Model.ScoreMatching >= 50)
            {
                <span class="badge bg-warning text-dark">@($"{@Model.ScoreMatching} %")</span>
            }
            else
            {
                <span class="badge bg-danger">@($"{@Model.ScoreMatching} %")</span>
            }
        </td>
    </tr>

</table>

<a asp-controller="CV"
   asp-action="MesCV"
   class="btn btn-secondary">
    Retour
</a>
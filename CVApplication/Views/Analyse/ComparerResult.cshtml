@model CVApplication.ViewModels.ResultatMatchingViewModel

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h2><i class="bi bi-arrow-left-right"></i> Résultat du matching</h2>
    </div>
    <div class="card-body">
        <table class="table table-bordered align-middle">
            <tr>
                <th><i class="bi bi-file-earmark-text"></i> CV</th>
                <td>@Model.CV.Nom</td>
            </tr>
            <tr>
                <th><i class="bi bi-briefcase"></i> Offre</th>
                <td>@Model.Offre.Titre</td>
            </tr>
            <tr>
                <th><i class="bi bi-bar-chart"></i> Score de matching</th>
                <td>
                    <div class="progress" style="height: 25px; position: relative;">
                        <div class="progress-bar 
            @(Model.ScoreMatching >= 80 ? "bg-success" 
            : Model.ScoreMatching >= 50 ? "bg-warning" 
            : Model.ScoreMatching > 0 ? "bg-danger" 
            : "bg-secondary")"
                             role="progressbar"
                             style="width:@(Model.ScoreMatching > 0 ? Model.ScoreMatching : 5)%">
                        </div>
                        <span class="position-absolute w-100 text-center fw-bold 
            @(Model.ScoreMatching >= 50 ? "text-white" : "text-dark")" 
                              style="top: 0; left: 0;">
                            @Model.ScoreMatching %
                        </span>
                    </div>
                </td>

            </tr>
        </table>

        <div class="mt-3">
            <a asp-controller="CV"
               asp-action="MesCV"
               class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
        </div>
    </div>
</div>
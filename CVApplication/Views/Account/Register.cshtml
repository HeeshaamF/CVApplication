@model CVApplication.ViewModels.RegisterViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center">
                    <h3><i class="bi bi-person-plus"></i> Créer un compte</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Register" method="post">
                        
                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-person"></i> Nom</label>
                            <input asp-for="Nom" class="form-control" placeholder="Entrez votre nom"/>
                            <span asp-validation-for="Nom" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-envelope"></i> Email</label>
                            <input asp-for="Email" class="form-control" placeholder="exemple@mail.com"/>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-lock"></i> Mot de passe</label>
                            <input asp-for="MotDePasse" type="password" class="form-control" placeholder="********"/>
                            <span asp-validation-for="MotDePasse" class="text-danger small"></span>
                            <div class="form-text">
                                Le mot de passe doit contenir au moins 8 caractères dont une minuscule, une majuscule et un chiffre.
                            </div>
                            <!-- Barre de progression -->
                            <div class="progress mt-2">
                                <div id="passwordStrength" class="progress-bar" role="progressbar" style="width: 0%">
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-lock-fill"></i> Confirmer le mot de passe</label>
                            <input asp-for="ConfirmMotDePasse" type="password" class="form-control" placeholder="********"/>
                            <span asp-validation-for="ConfirmMotDePasse" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle"></i> S'inscrire
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Exemple simple de barre de progression mot de passe
        const pwd = document.querySelector("input[name='MotDePasse']");
        const bar = document.getElementById("passwordStrength");
        pwd.addEventListener("input", () => {
            let strength = 0;
            if (pwd.value.length >= 8) strength += 25;
            if (/[a-z]/.test(pwd.value)) strength += 25;
            if (/[A-Z]/.test(pwd.value)) strength += 25;
            if (/[0-9]/.test(pwd.value)) strength += 25;
            bar.style.width = strength + "%";
            bar.className = "progress-bar bg-" + (strength < 50 ? "danger" : strength < 75 ? "warning" : "success");
        });
    </script>
}

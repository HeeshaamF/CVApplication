@model CVApplication.ViewModels.RegisterViewModel

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-header text-center">
                    <h3>Créer un compte</h3>
                </div>

                <div class="card-body">

                    <form asp-action="Register" method="post">

                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label>Nom</label>
                            <input asp-for="Nom" class="form-control"/>
                            <span asp-validation-for="Nom" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label>Email</label>
                            <input asp-for="Email" class="form-control"/>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label>Mot de passe</label>
                            <input asp-for="MotDePasse" type="password" class="form-control"/>
                            <span asp-validation-for="MotDePasse" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label>Confirmer le mot de passe</label>
                            <input asp-for="ConfirmMotDePasse" type="password" class="form-control"/>
                            <span asp-validation-for="ConfirmMotDePasse" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            S'inscrire
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>